{
  "name": "@xynes/platform-contracts",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test:coverage": "vitest run --coverage",
    "contracts:export": "tsc -p tsconfig.tools.json && node .contract-tools/scripts/export-cms-delivery-contract.js",
    "contracts:check": "tsc -p tsconfig.tools.json && node .contract-tools/scripts/export-cms-delivery-contract.js --check",
    "test:peers": "vitest run scripts/tests/cms-delivery-peers.test.ts",
    "internal-request:export": "tsc -p tsconfig.tools.json && node .contract-tools/scripts/export-internal-request.js",
    "internal-request:check": "tsc -p tsconfig.tools.json && node .contract-tools/scripts/export-internal-request.js --check",
    "cms-policy:export": "tsc -p tsconfig.tools.json && node .contract-tools/scripts/export-cms-publication-policy.js",
    "cms-policy:check": "tsc -p tsconfig.tools.json && node .contract-tools/scripts/export-cms-publication-policy.js --check"
  },
  "peerDependencies": {
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.11.10",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "8.49.0",
    "vitest": "^1.2.1",
    "zod": "^3.25.76",
    "zod4": "npm:zod@4.4.3"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
